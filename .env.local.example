# Copia questo file in .env.local e compila con i tuoi valori Supabase
# Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo (email notifiche turni)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=tua@email.com
BREVO_SENDER_NAME=Turnify

# Web Push VAPID
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:admin@example.com
